<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 全功能面板：三层垂直均匀分布(SpaceBetween) — 顶部伪搜索框(加高) / 中部4×3平台网格(最多12图标) / 底部最近搜索 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_searchbar_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:tint="#888888"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="搜点什么…"
            android:textSize="13sp"
            android:textColor="@color/widget_subtext" />
    </LinearLayout>

    <!-- weight=1 吃掉中间剩余空间，使搜索框顶置、最近搜索置底，实现 SpaceBetween 分布 -->
    <LinearLayout
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/widget_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_recent_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近："
            android:textSize="10sp"
            android:textColor="@color/widget_subtext"
            android:includeFontPadding="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_recent_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
